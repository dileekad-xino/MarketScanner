<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MarketScanner.Converters"
             xmlns:models="clr-namespace:MarketScanner.Models"
             x:Class="MarketScanner.Views.AlgoRunnerPage"
             Title="Algorithm Runner"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:ChangeToColorConverter x:Key="ChangeToColorConverter"/>
            <converters:AlgoActionToColorConverter x:Key="AlgoActionToColorConverter"/>
            <converters:RsiSignalToColorConverter x:Key="RsiSignalToColorConverter"/>
            <converters:NullableDoubleToBoolConverter x:Key="NullableDoubleToBoolConverter"/>
            <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" 
          Padding="20"
          BackgroundColor="{StaticResource BackgroundDark}">

        <!-- Symbol Information -->
        <Border Grid.Row="0"
                StrokeThickness="1"
                Stroke="{StaticResource BorderDark}"
                BackgroundColor="{StaticResource SurfaceDark}"
                Padding="15"
                Margin="0,0,0,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4"/>
            </Border.StrokeShape>
            
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0"
                       Text="Symbol:"
                       TextColor="{StaticResource OnSurfaceVariantDark}"
                       FontSize="14"
                       VerticalOptions="Center"
                       Margin="0,0,10,0"/>
                <Label Grid.Column="1"
                       Text="{Binding SelectedSymbol.Symbol}"
                       TextColor="{StaticResource OnSurfaceDark}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Price Information -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="15"
              Margin="0,0,0,15">
            <Border Grid.Column="0"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderDark}"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="Current Price"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="12"/>
                    <Label Text="{Binding SelectedSymbol.LastPrice, StringFormat='{0:C2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderDark}"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="Change %"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="12"/>
                    <Label Text="{Binding SelectedSymbol.ChangePercent, StringFormat='{0:+#0.00;-#0.00;0.00}%'}"
                           TextColor="{Binding SelectedSymbol.ChangePercent, Converter={StaticResource ChangeToColorConverter}}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Result Display -->
        <Border Grid.Row="2"
                StrokeThickness="2"
                Stroke="{Binding Result.Action, Converter={StaticResource AlgoActionToColorConverter}}"
                BackgroundColor="{StaticResource SurfaceDark}"
                Padding="20"
                Margin="0,0,0,15"
                IsVisible="{Binding Result, Converter={StaticResource StringToBoolConverter}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4"/>
            </Border.StrokeShape>
            
            <VerticalStackLayout Spacing="15">
                <!-- Action Indicator -->
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Text="Action:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding Result.Action}"
                           TextColor="{Binding Result.Action, Converter={StaticResource AlgoActionToColorConverter}}"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Suggested Price -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding Result.Price, Converter={StaticResource StringToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="Suggested Price:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding Result.Price, StringFormat='{0:C2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- RSI Value -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding Result.RsiValue, Converter={StaticResource NullableDoubleToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="RSI:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding Result.RsiValue, StringFormat='{0:F2}'}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontFamily="Cascadia Mono, Consolas, Menlo"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Signal -->
                <Grid ColumnDefinitions="Auto,*"
                      IsVisible="{Binding Result.RsiSignal, Converter={StaticResource StringToBoolConverter}}">
                    <Label Grid.Column="0"
                           Text="Signal:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                    <Label Grid.Column="1"
                           Text="{Binding Result.RsiSignal}"
                           TextColor="{Binding Result.RsiSignal, Converter={StaticResource RsiSignalToColorConverter}}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Reason -->
                <Grid RowDefinitions="Auto,*"
                      IsVisible="{Binding Result.Reason, Converter={StaticResource StringToBoolConverter}}">
                    <Label Grid.Row="0"
                           Text="Reason:"
                           TextColor="{StaticResource OnSurfaceVariantDark}"
                           FontSize="14"
                           Margin="0,0,0,5"/>
                    <Label Grid.Row="1"
                           Text="{Binding Result.Reason}"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="13"
                           LineBreakMode="WordWrap"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Error Message -->
        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               TextColor="{StaticResource ErrorColor}"
               FontSize="13"
               Margin="0,0,0,15"
               LineBreakMode="WordWrap"/>

        <!-- Position Tracking Toggle -->
        <Border Grid.Row="4"
                StrokeThickness="1"
                Stroke="{StaticResource BorderDark}"
                BackgroundColor="{StaticResource SurfaceDark}"
                Padding="15"
                Margin="0,0,0,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*">
                <CheckBox Grid.Column="0"
                         IsChecked="{Binding IsTrackingMode, Mode=TwoWay}"
                         VerticalOptions="Center"
                         Margin="0,0,10,0"/>
                <Label Grid.Column="1"
                       Text="Enable Position Tracking (Simulated Trade)"
                       TextColor="{StaticResource OnSurfaceDark}"
                       FontSize="14"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Position Status (when tracking) -->
        <Border Grid.Row="5"
                StrokeThickness="2"
                Stroke="#4CAF50"
                BackgroundColor="{StaticResource SurfaceDark}"
                Padding="15"
                Margin="0,0,0,15"
                IsVisible="{Binding CurrentPosition, Converter={StaticResource ObjectToBoolConverter}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label Text="🟢 OPEN POSITION"
                       TextColor="#4CAF50"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Label Text="{Binding PositionStatus}"
                       TextColor="{StaticResource OnSurfaceDark}"
                       FontSize="13"
                       LineBreakMode="WordWrap"/>
                <Label Text="Monitoring for exit conditions..."
                       TextColor="{StaticResource OnSurfaceVariantDark}"
                       FontSize="12"
                       IsVisible="{Binding IsMonitoring}"/>
            </VerticalStackLayout>
        </Border>

        <!-- Completed Trades -->
        <Border Grid.Row="6"
                StrokeThickness="1"
                Stroke="{StaticResource BorderDark}"
                BackgroundColor="{StaticResource SurfaceDark}"
                Padding="15"
                Margin="0,0,0,15"
                IsVisible="{Binding HasCompletedTrades}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label Text="Completed Trades"
                       TextColor="{StaticResource OnSurfaceDark}"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <CollectionView ItemsSource="{Binding CompletedTrades}"
                                MaximumHeightRequest="200"
                                BackgroundColor="Transparent">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    Stroke="{StaticResource BorderDark}"
                                    BackgroundColor="{StaticResource BackgroundDark}"
                                    Padding="10"
                                    Margin="0,0,0,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Symbol}"
                                           TextColor="{StaticResource OnSurfaceDark}"
                                           FontSize="14"
                                           FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="Entry:"
                                               TextColor="{StaticResource OnSurfaceVariantDark}"
                                               FontSize="12"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding EntrySignal}"
                                               TextColor="#4CAF50"
                                               FontSize="12"/>
                                    </Grid>
                                    <Label Text="{Binding EntryPrice, StringFormat='@ ${0:F2}'}"
                                           TextColor="{StaticResource OnSurfaceVariantDark}"
                                           FontSize="11"
                                           Margin="20,0,0,0"/>
                                    <Label Text="{Binding EntryRsi, StringFormat='RSI: {0:F1}'}"
                                           TextColor="{StaticResource OnSurfaceVariantDark}"
                                           FontSize="11"
                                           Margin="20,0,0,0"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="Exit:"
                                               TextColor="{StaticResource OnSurfaceVariantDark}"
                                               FontSize="12"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding ExitSignal}"
                                               TextColor="#F44336"
                                               FontSize="12"/>
                                    </Grid>
                                    <Label Text="{Binding ExitPrice, StringFormat='@ ${0:F2}'}"
                                           TextColor="{StaticResource OnSurfaceVariantDark}"
                                           FontSize="11"
                                           Margin="20,0,0,0"/>
                                    <Label Text="{Binding ExitRsi, StringFormat='RSI: {0:F1}'}"
                                           TextColor="{StaticResource OnSurfaceVariantDark}"
                                           FontSize="11"
                                           Margin="20,0,0,0"/>
                                    <Label Text="{Binding RealizedPnLPercent, StringFormat='PnL: {0:+#0.00;-#0.00;0.00}%'}"
                                           TextColor="{Binding RealizedPnLPercent, Converter={StaticResource ChangeToColorConverter}}"
                                           FontSize="12"
                                           FontFamily="Cascadia Mono, Consolas, Menlo"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding Duration, StringFormat='Duration: {0:mm\\:ss}'}"
                                           TextColor="{StaticResource OnSurfaceVariantDark}"
                                           FontSize="11"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="7"
              ColumnDefinitions="*,*"
              ColumnSpacing="15">
            <Button Grid.Column="0"
                    Text="Run Algorithm"
                    Command="{Binding RunAlgoCommand}"
                    BackgroundColor="{StaticResource PrimaryDark}"
                    TextColor="{StaticResource TextOnAccent}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InvertedBoolConverter}}"
                    HeightRequest="40"/>
            <Button Grid.Column="1"
                    Text="Close"
                    Command="{Binding CloseCommand}"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    TextColor="{StaticResource OnSurfaceDark}"
                    HeightRequest="40"/>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="8"
                           IsRunning="{Binding IsRunning}"
                           IsVisible="{Binding IsRunning}"
                           Color="{StaticResource PrimaryDark}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>

