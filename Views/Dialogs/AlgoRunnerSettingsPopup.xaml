<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="MarketScanner.Views.Dialogs.AlgoRunnerSettingsPopup"
               Color="#B3000000">
    <Border BackgroundColor="{StaticResource BackgroundDark}"
            Stroke="{StaticResource BorderDark}"
            StrokeThickness="1"
            Padding="20"
            WidthRequest="700"
            MaximumWidthRequest="840"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8"/>
        </Border.StrokeShape>

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
              RowSpacing="14"
              MinimumHeightRequest="620">
            <Label x:Name="TitleLabel"
                   Text="Algo Runner Settings"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurfaceDark}"/>

            <HorizontalStackLayout x:Name="TabHeaderHost"
                                   Grid.Row="1"
                                   Spacing="8"/>

            <Border Grid.Row="2"
                    Stroke="{StaticResource BorderDark}"
                    StrokeThickness="1"
                    Padding="14"
                    BackgroundColor="{StaticResource SurfaceDark}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6"/>
                </Border.StrokeShape>
                <ContentView x:Name="TabContentHost"/>
            </Border>

            <Grid Grid.Row="3"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Defaults"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnDefaultsClicked"
                        MinimumWidthRequest="80"
                        HeightRequest="36"/>
                <Button Grid.Column="2"
                        Text="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnCancelClicked"
                        MinimumWidthRequest="80"
                        HeightRequest="36"/>
                <Button Grid.Column="3"
                        Text="Ok"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnOkClicked"
                        MinimumWidthRequest="80"
                        HeightRequest="36"/>
            </Grid>

            <Label Grid.Row="4"
                   x:Name="ErrorLabel"
                   TextColor="{StaticResource ErrorColor}"
                   FontSize="12"
                   IsVisible="False"/>
        </Grid>
    </Border>
</toolkit:Popup>
