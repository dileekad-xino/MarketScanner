<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="MarketScanner.Views.Dialogs.RsiSettingsPopup"
               Color="#B3000000">
    <Border BackgroundColor="{StaticResource BackgroundDark}"
            Stroke="{StaticResource BorderDark}"
            StrokeThickness="1"
            Padding="20"
            WidthRequest="420"
            MaximumWidthRequest="500"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8"/>
        </Border.StrokeShape>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="16"
              MinimumHeightRequest="350">
            <Label Text="RSI Settings"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnSurfaceDark}"/>

            <Border Grid.Row="1"
                    Stroke="{StaticResource BorderDark}"
                    StrokeThickness="1"
                    Padding="16"
                    BackgroundColor="{StaticResource SurfaceDark}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6"/>
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="16"
                      MinimumHeightRequest="220">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Label Text="Length"
                               TextColor="{StaticResource OnSurfaceDark}"
                               VerticalOptions="Center"/>
                        <Entry x:Name="PeriodEntry"
                               Grid.Column="1"
                               Keyboard="Numeric"
                               Style="{StaticResource FilterEntryStyle}"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Label Text="Oversold"
                               TextColor="{StaticResource OnSurfaceDark}"
                               VerticalOptions="Center"/>
                        <Entry x:Name="OversoldEntry"
                               Grid.Column="1"
                               Keyboard="Numeric"
                               Style="{StaticResource FilterEntryStyle}"/>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Label Text="Overbought"
                               TextColor="{StaticResource OnSurfaceDark}"
                               VerticalOptions="Center"/>
                        <Entry x:Name="OverboughtEntry"
                               Grid.Column="1"
                               Keyboard="Numeric"
                               Style="{StaticResource FilterEntryStyle}"/>
                    </Grid>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Label Text="Historical Days"
                               TextColor="{StaticResource OnSurfaceDark}"
                               VerticalOptions="Center"/>
                        <Entry x:Name="DaysEntry"
                               Grid.Column="1"
                               Keyboard="Numeric"
                               Style="{StaticResource FilterEntryStyle}"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="12"
                  Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="Defaults"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnDefaultsClicked"
                        MinimumWidthRequest="80"
                        HeightRequest="36"/>
                <Button Grid.Column="2"
                        Text="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnCancelClicked"
                        MinimumWidthRequest="80"
                        HeightRequest="36"/>
                <Button Grid.Column="3"
                        Text="Ok"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnOkClicked"
                        MinimumWidthRequest="80"
                        HeightRequest="36"/>
            </Grid>

            <Label Grid.Row="3"
                   x:Name="ErrorLabel"
                   TextColor="{StaticResource ErrorColor}"
                   FontSize="12"
                   IsVisible="False"/>
        </Grid>
    </Border>
</toolkit:Popup>

