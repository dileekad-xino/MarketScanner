<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MarketScanner.Converters"
             xmlns:utils="clr-namespace:MarketScanner.Utilities"
             xmlns:beh="clr-namespace:MarketScanner.Behaviors"
             xmlns:svc="clr-namespace:MarketScanner.Services"
             xmlns:controls="clr-namespace:MarketScanner.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:MarketScanner.Views"
             x:Class="MarketScanner.Views.ScannerPage"
             x:Name="ScannerPageRoot"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ChangeToColorConverter x:Key="ChangeToColorConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:EqualityConverter x:Key="EqInt"/>
            <converters:DecimalNullableConverter x:Key="DecimalNullableConverter"/>
            <converters:BoolToAccentColorConverter x:Key="BoolToAccentConverter"/>
            <converters:RsiSignalToColorConverter x:Key="RsiSignalColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDataCommand}"
                 BackgroundColor="{StaticResource BackgroundDark}">

        <!-- Main 2-Column Tiled Layout -->
        <Grid ColumnDefinitions="*,*"
              RowDefinitions="*,*"
              BackgroundColor="{StaticResource BackgroundDark}"
              Padding="8"
              RowSpacing="8"
              ColumnSpacing="8">

            <!-- Left Column - Top: Market Scanner Tile -->
            <Border Grid.Column="0"
                    Grid.Row="0"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderDark}"
                    BackgroundColor="{StaticResource BackgroundDark}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                
                <Grid RowDefinitions="Auto,*"
                      BackgroundColor="{StaticResource BackgroundDark}">
                    
                    <!-- Scanner Tile Header -->
                    <Label Grid.Row="0"
                           Text="Market Scanner"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontAttributes="Bold"
                           Padding="10,8"
                           BackgroundColor="{StaticResource SurfaceDark}"/>

                    <!-- Scanner Content with Filters -->
                    <ScrollView Grid.Row="1"
                                Orientation="Vertical"
                                VerticalScrollBarVisibility="Default">
                        <Grid RowDefinitions="Auto,*"
                              BackgroundColor="{StaticResource BackgroundDark}">
                            
                            <!-- Filters Panel (integrated into Scanner tile) -->
                            <Border Grid.Row="0"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource BorderDark}"
                                    BackgroundColor="{StaticResource SurfaceDark}"
                                    Padding="12"
                                    Margin="8,8,8,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4"/>
                                </Border.StrokeShape>
                                
                                <StackLayout Spacing="12">
                                    <!-- Market Status -->
                                    <StackLayout BackgroundColor="{StaticResource SurfaceDark}"
                                                 Padding="8"
                                                 Margin="0,0,0,8">
                                        <Label Text="Market Status"
                                               Style="{StaticResource FilterLabelStyle}"
                                               FontSize="11"/>
                                        <Label Text="{Binding MarketStatus}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                    </StackLayout>

                                    <Label Text="Filters"
                                           Style="{StaticResource HeaderLabel}"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center"/>

                                    <!-- Exchange Filter -->
                                    <StackLayout>
                                        <Label Text="Exchange"
                                               Style="{StaticResource FilterLabelStyle}"/>
                                        <Picker ItemsSource="{Binding ExchangeOptions}"
                                                SelectedItem="{Binding Exchange, Mode=TwoWay}"
                                                Style="{StaticResource FilterPickerStyle}"/>
                                    </StackLayout>

                                    <!-- Price Range Filter -->
                                    <StackLayout>
                                        <Label Text="Price Range"
                                               Style="{StaticResource FilterLabelStyle}"/>
                                        <Grid ColumnDefinitions="*,*,*"
                                              ColumnSpacing="8">
                                            <Entry Grid.Column="0"
                                                   Text="{Binding MinPriceText, Mode=TwoWay, Converter={StaticResource NullableDecimal}}"
                                                   Placeholder="Min"
                                                   Style="{StaticResource FilterEntryStyle}"
                                                   Keyboard="Numeric"
                                                   TextChanged="OnFilterTextChanged"/>
                                            <Label Grid.Column="1"
                                                   Text="to"
                                                   Style="{StaticResource FilterLabelStyle}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                            <Entry Grid.Column="2"
                                                   Text="{Binding MaxPriceText, Mode=TwoWay, Converter={StaticResource NullableDecimal}}"
                                                   Placeholder="Max"
                                                   Style="{StaticResource FilterEntryStyle}"
                                                   Keyboard="Numeric"
                                                   TextChanged="OnFilterTextChanged"/>
                                        </Grid>
                                    </StackLayout>

                                    <!-- Volume Filter -->
                                    <StackLayout>
                                        <Label Text="Min Volume"
                                               Style="{StaticResource FilterLabelStyle}"/>
                                        <Entry Text="{Binding VolumeMinText, Mode=TwoWay, Converter={StaticResource NullableDecimal}}"
                                               Placeholder="e.g., 100000"
                                               Style="{StaticResource FilterEntryStyle}"
                                               Keyboard="Numeric"
                                               TextChanged="OnFilterTextChanged"/>
                                    </StackLayout>

                                    <!-- Change % Range Filter -->
                                    <StackLayout>
                                        <Label Text="Min Change %"
                                               Style="{StaticResource FilterLabelStyle}"/>
                                        <Entry Text="{Binding MinChangePercentText, Mode=TwoWay, Converter={StaticResource NullableDecimal}}"
                                               Placeholder="e.g., 5"
                                               Style="{StaticResource FilterEntryStyle}"
                                               Keyboard="Numeric"
                                               TextChanged="OnFilterTextChanged"/>
                                    </StackLayout>

                                    <!-- Top N Filter -->
                                    <StackLayout>
                                        <Label Text="Top N"
                                               Style="{StaticResource FilterLabelStyle}"/>
                                        <Picker ItemsSource="{Binding TopNOptions}"
                                                SelectedItem="{Binding TopN, Mode=TwoWay}"
                                                Style="{StaticResource FilterPickerStyle}"/>
                                    </StackLayout>

                                    <!-- Auto-refresh control -->
                                    <controls:AutoRefreshControl
                                        AutoRefreshEnabled="{Binding AutoRefreshEnabled, Mode=TwoWay}"
                                        RefreshIntervalSeconds="{Binding RefreshIntervalSeconds, Mode=TwoWay}"
                                        Margin="0,16,0,0"/>

                                    <!-- Refresh and Reset buttons -->
                                    <Grid RowDefinitions="Auto,Auto"
                                          RowSpacing="10"
                                          Margin="0,16,0,0">
                                        <Button Text="Refresh"
                                                Command="{Binding RefreshCommand}"/>
                                        <Button Grid.Row="1"
                                                Text="Reset Filters"
                                                Style="{StaticResource ResetButtonStyle}"
                                                Command="{Binding ResetFiltersCommand}"/>
                                    </Grid>

                                    <!-- Error Message -->
                                    <Label Text="{Binding ErrorMessage}"
                                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                                           Style="{StaticResource ErrorLabelStyle}"/>
                                </StackLayout>
                            </Border>

                            <!-- Scanner Table -->
                            <Grid Grid.Row="1"
                                  BackgroundColor="{StaticResource BackgroundDark}">
                                
                                <ScrollView x:Name="TableScroll"
                                            Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Always"
                                            BackgroundColor="{StaticResource BackgroundDark}"
                                            Margin="8,0,8,8">

                                    <Grid x:Name="TableRoot"
                                          BackgroundColor="{StaticResource BackgroundDark}"
                                          RowDefinitions="Auto,*">

                                        <!-- Table Header -->
                                        <Grid x:Name="HeaderGrid"
                                              Grid.Row="0"
                                              BackgroundColor="{StaticResource SurfaceDark}"
                                              HeightRequest="40">

                                            <!-- Symbol Header -->
                                            <Label Grid.Column="0"
                                                   Text="Symbol"
                                                   Style="{StaticResource HeaderLabel}"
                                                   HorizontalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer NumberOfTapsRequired="2"/>
                                                </Label.GestureRecognizers>
                                                <Label.Behaviors>
                                                    <beh:HeaderAutoSizeBehavior ColumnIndex="0"/>
                                                </Label.Behaviors>
                                            </Label>

                                            <!-- Company Header -->
                                            <Label Grid.Column="1"
                                                   Text="Company"
                                                   Style="{StaticResource HeaderLabel}"
                                                   HorizontalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer NumberOfTapsRequired="2"/>
                                                </Label.GestureRecognizers>
                                                <Label.Behaviors>
                                                    <beh:HeaderAutoSizeBehavior ColumnIndex="1"/>
                                                </Label.Behaviors>
                                            </Label>

                                            <!-- Change % Header -->
                                            <Label Grid.Column="2"
                                                   Text="Change %"
                                                   Style="{StaticResource HeaderLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer NumberOfTapsRequired="2"/>
                                                </Label.GestureRecognizers>
                                                <Label.Behaviors>
                                                    <beh:HeaderAutoSizeBehavior ColumnIndex="2"/>
                                                </Label.Behaviors>
                                            </Label>

                                            <!-- Change Header -->
                                            <Label Grid.Column="3"
                                                   Text="Change"
                                                   Style="{StaticResource HeaderLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer NumberOfTapsRequired="2"/>
                                                </Label.GestureRecognizers>
                                                <Label.Behaviors>
                                                    <beh:HeaderAutoSizeBehavior ColumnIndex="3"/>
                                                </Label.Behaviors>
                                            </Label>

                                            <!-- Last Price Header -->
                                            <Label Grid.Column="4"
                                                   Text="Last Price"
                                                   Style="{StaticResource HeaderLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer NumberOfTapsRequired="2"/>
                                                </Label.GestureRecognizers>
                                                <Label.Behaviors>
                                                    <beh:HeaderAutoSizeBehavior ColumnIndex="4"/>
                                                </Label.Behaviors>
                                            </Label>

                                            <!-- RV Header -->
                                            <Label Grid.Column="5"
                                                   Text="RV"
                                                   Style="{StaticResource HeaderLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer NumberOfTapsRequired="2"/>
                                                </Label.GestureRecognizers>
                                                <Label.Behaviors>
                                                    <beh:HeaderAutoSizeBehavior ColumnIndex="5"/>
                                                </Label.Behaviors>
                                            </Label>

                                            <!-- Volume Header -->
                                            <Label Grid.Column="6"
                                                   Text="Volume"
                                                   Style="{StaticResource HeaderLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer NumberOfTapsRequired="2"/>
                                                </Label.GestureRecognizers>
                                                <Label.Behaviors>
                                                    <beh:HeaderAutoSizeBehavior ColumnIndex="6"/>
                                                </Label.Behaviors>
                                            </Label>

                                            <!-- Avg Vol Header -->
                                            <Label Grid.Column="7"
                                                   Text="Avg Vol"
                                                   Style="{StaticResource HeaderLabel}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer NumberOfTapsRequired="2"/>
                                                </Label.GestureRecognizers>
                                                <Label.Behaviors>
                                                    <beh:HeaderAutoSizeBehavior ColumnIndex="7"/>
                                                </Label.Behaviors>
                                            </Label>

                                            <!-- Resize Grips -->
                                            <BoxView Grid.Column="0"
                                                     Style="{StaticResource HeaderGrip}"
                                                     Margin="-4,0,-4,0"
                                                     ZIndex="10">
                                                <BoxView.Behaviors>
                                                    <utils:ColumnResizeBehavior ColumnIndex="0"/>
                                                </BoxView.Behaviors>
                                            </BoxView>

                                            <BoxView Grid.Column="1"
                                                     Style="{StaticResource HeaderGrip}"
                                                     Margin="-4,0,-4,0"
                                                     ZIndex="10">
                                                <BoxView.Behaviors>
                                                    <utils:ColumnResizeBehavior ColumnIndex="1"/>
                                                </BoxView.Behaviors>
                                            </BoxView>

                                            <BoxView Grid.Column="2"
                                                     Style="{StaticResource HeaderGrip}"
                                                     Margin="-4,0,-4,0"
                                                     ZIndex="10">
                                                <BoxView.Behaviors>
                                                    <utils:ColumnResizeBehavior ColumnIndex="2"/>
                                                </BoxView.Behaviors>
                                            </BoxView>

                                            <BoxView Grid.Column="3"
                                                     Style="{StaticResource HeaderGrip}"
                                                     Margin="-4,0,-4,0"
                                                     ZIndex="10">
                                                <BoxView.Behaviors>
                                                    <utils:ColumnResizeBehavior ColumnIndex="3"/>
                                                </BoxView.Behaviors>
                                            </BoxView>

                                            <BoxView Grid.Column="4"
                                                     Style="{StaticResource HeaderGrip}"
                                                     Margin="-4,0,-4,0"
                                                     ZIndex="10">
                                                <BoxView.Behaviors>
                                                    <utils:ColumnResizeBehavior ColumnIndex="4"/>
                                                </BoxView.Behaviors>
                                            </BoxView>

                                            <BoxView Grid.Column="5"
                                                     Style="{StaticResource HeaderGrip}"
                                                     Margin="-4,0,-4,0"
                                                     ZIndex="10">
                                                <BoxView.Behaviors>
                                                    <utils:ColumnResizeBehavior ColumnIndex="5"/>
                                                </BoxView.Behaviors>
                                            </BoxView>

                                            <BoxView Grid.Column="6"
                                                     Style="{StaticResource HeaderGrip}"
                                                     Margin="-4,0,-4,0"
                                                     ZIndex="10">
                                                <BoxView.Behaviors>
                                                    <utils:ColumnResizeBehavior ColumnIndex="6"/>
                                                </BoxView.Behaviors>
                                            </BoxView>

                                            <BoxView Grid.Column="7"
                                                     Style="{StaticResource HeaderGrip}"
                                                     Margin="-4,0,-4,0"
                                                     ZIndex="10">
                                                <BoxView.Behaviors>
                                                    <utils:ColumnResizeBehavior ColumnIndex="7"/>
                                                </BoxView.Behaviors>
                                            </BoxView>

                                        </Grid>

                                        <!-- Table Rows -->
                                        <CollectionView x:Name="Rows"
                                                        Grid.Row="1"
                                                        ItemsSource="{Binding ScannerItems}"
                                                        BackgroundColor="#1a1a1a"
                                                        SelectionMode="None"
                                                        ItemsUpdatingScrollMode="KeepScrollOffset"
                                                        ItemsLayout="VerticalList">

                                            <!-- DataTemplate is set programmatically in code-behind -->

                                            <CollectionView.EmptyView>
                                                <StackLayout VerticalOptions="CenterAndExpand"
                                                             HorizontalOptions="CenterAndExpand">
                                                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                                                       IsVisible="{Binding IsLoading}"
                                                                       Color="{StaticResource PrimaryDark}"/>
                                                    <Label Text="No data available. Adjust filters or try again."
                                                           IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                                                           TextColor="{StaticResource OnSurfaceVariantDark}"
                                                           HorizontalOptions="Center"
                                                           Margin="0,16,0,0"/>
                                                    <Label Text="{Binding ErrorMessage}"
                                                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                                                           Style="{StaticResource ErrorLabelStyle}"/>
                                                    <Button Text="Retry"
                                                            Command="{Binding LoadDataCommand}"
                                                            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                                </StackLayout>
                                            </CollectionView.EmptyView>
                                        </CollectionView>
                                    </Grid>
                                </ScrollView>
                            </Grid>
                        </Grid>
                    </ScrollView>
                </Grid>
            </Border>

            <!-- Left Column - Bottom: Quotes and Algo Runners -->
            <Grid Grid.Column="0"
                  Grid.Row="1"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="8">

                <!-- Quotes Tile -->
                <Border Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderDark}"
                        BackgroundColor="{StaticResource BackgroundDark}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4"/>
                    </Border.StrokeShape>
                    
                    <Grid RowDefinitions="Auto,*"
                          BackgroundColor="{StaticResource BackgroundDark}">
                        <Label Grid.Row="0"
                               Text="Quotes"
                               TextColor="{StaticResource OnSurfaceDark}"
                               FontSize="16"
                               FontAttributes="Bold"
                               Padding="10,8"
                               BackgroundColor="{StaticResource SurfaceDark}"/>
                        <ScrollView Grid.Row="1"
                                    Orientation="Vertical"
                                    VerticalScrollBarVisibility="Default">
                            <local:QuoteContentView 
                                BindingContext="{Binding QuoteViewModel}" />
                        </ScrollView>
                    </Grid>
                </Border>

                <!-- Algo Runners Tile -->
                <Border Grid.Column="1"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderDark}"
                        BackgroundColor="{StaticResource BackgroundDark}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4"/>
                    </Border.StrokeShape>
                    
                    <Grid RowDefinitions="Auto,*"
                          BackgroundColor="{StaticResource BackgroundDark}">
                        <Label Grid.Row="0"
                               Text="Algo Runner"
                               TextColor="{StaticResource OnSurfaceDark}"
                               FontSize="16"
                               FontAttributes="Bold"
                               Padding="10,8"
                               BackgroundColor="{StaticResource SurfaceDark}"/>
                        <ScrollView Grid.Row="1"
                                    Orientation="Vertical"
                                    VerticalScrollBarVisibility="Default">
                            <StackLayout Spacing="8"
                                         Padding="8">
                                <CollectionView ItemsSource="{Binding AlgoRunners}"
                                                SelectionMode="None"
                                                BackgroundColor="Transparent">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <local:AlgoRunnerTile BindingContext="{Binding .}"/>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                    <CollectionView.EmptyView>
                                        <Label Text="No active algo runners. Right-click a symbol in Quotes to run an algorithm."
                                               TextColor="{StaticResource OnSurfaceVariantDark}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Padding="20"
                                               HorizontalTextAlignment="Center"/>
                                    </CollectionView.EmptyView>
                                </CollectionView>
                                
                                <!-- Show "+ X more algos" if there are more than 3 -->
                                <Label Text="{Binding BindingContext.MoreAlgosText, Source={x:Reference ScannerPageRoot}}"
                                       IsVisible="{Binding BindingContext.HasMoreAlgos, Source={x:Reference ScannerPageRoot}}"
                                       TextColor="{StaticResource OnSurfaceVariantDark}"
                                       FontSize="12"
                                       HorizontalOptions="Center"
                                       Padding="8"/>
                            </StackLayout>
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column - Top: Watchlists Tile -->
            <Border Grid.Column="1"
                    Grid.Row="0"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderDark}"
                    BackgroundColor="{StaticResource BackgroundDark}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                
                <Grid RowDefinitions="Auto,*"
                      BackgroundColor="{StaticResource BackgroundDark}">
                    <Label Grid.Row="0"
                           Text="Watchlists"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontAttributes="Bold"
                           Padding="10,8"
                           BackgroundColor="{StaticResource SurfaceDark}"/>
                    <ScrollView Grid.Row="1"
                                Orientation="Vertical"
                                VerticalScrollBarVisibility="Default">
                        <local:WatchlistContentView 
                            BindingContext="{Binding WatchlistViewModel}" />
                    </ScrollView>
                </Grid>
            </Border>

            <!-- Right Column - Bottom: Daily P/L Tile -->
            <Border Grid.Column="1"
                    Grid.Row="1"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderDark}"
                    BackgroundColor="{StaticResource BackgroundDark}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                
                <Grid RowDefinitions="Auto,*"
                      BackgroundColor="{StaticResource BackgroundDark}">
                    <Label Grid.Row="0"
                           Text="Daily P/L"
                           TextColor="{StaticResource OnSurfaceDark}"
                           FontSize="16"
                           FontAttributes="Bold"
                           Padding="10,8"
                           BackgroundColor="{StaticResource SurfaceDark}"/>
                    <ScrollView Grid.Row="1"
                                Orientation="Vertical"
                                VerticalScrollBarVisibility="Default">
                        <local:DailyPlContentView 
                            BindingContext="{Binding DailyPlViewModel}" />
                    </ScrollView>
                </Grid>
            </Border>

        </Grid>
    </RefreshView>

</ContentPage>
